# Copy to secrets/.env.local (gitignored) or export in your shell.
# File-based secrets in secrets/dropbox.json take precedence when both are set
# (env vars are merged first, then JSON file fields override).

COLLECTOR_SECRETS_DIR=./secrets

# OAuth redirect base (must match a redirect URI registered in Dropbox console)
COLLECTOR_OAUTH_REDIRECT_BASE=http://localhost:8000

# Optional: encrypt OAuth tokens at rest in SQLite
# COLLECTOR_ENCRYPTION_KEY=  # Fernet key from: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Dropbox OAuth app credentials (authorization + token refresh)
DROPBOX_CLIENT_ID=YOUR_DROPBOX_APP_KEY
DROPBOX_CLIENT_SECRET=YOUR_DROPBOX_APP_SECRET

# Legacy: global connector tokens (optional if using per-project OAuth)
COLLECTOR_DROPBOX_ACCESS_TOKEN=YOUR_DROPBOX_ACCESS_TOKEN
COLLECTOR_DROPBOX_REFRESH_TOKEN=YOUR_DROPBOX_REFRESH_TOKEN_OPTIONAL
