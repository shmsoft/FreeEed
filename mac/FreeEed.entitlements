<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the FreeEed Java (jpackage) app.

  A JVM needs these to run under the hardened runtime that notarization
  requires; without them a signed app crashes on launch:
    - allow-jit / allow-unsigned-executable-memory: the JIT generates and
      executes code at runtime.
    - disable-library-validation: lets the JVM load its own bundled dylibs /
      JNI libs that aren't signed by the same Team ID.

  Keep this list MINIMAL — do not add network/file entitlements the app does
  not need. (Forensic soundness: processing makes no outbound calls.)
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
